# ---------------------------------------------------------------------------
# Copy the NON-SECRET block into  <project folder>\.env
# Copy the SECRET block into      %USERPROFILE%\.config\company-agent\.env
#
# This project folder is inside OneDrive and syncs to the cloud, so the secret
# block must not be stored here. Run `python config.py` to check what resolves.
# ---------------------------------------------------------------------------

# --- non-secret: safe to keep in the project folder ------------------------

# Your Supabase project. Dashboard -> Project Settings -> Data API.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# Publishable key. Designed to be shipped in client code; read-only against
# this schema because row level security grants SELECT only.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX

# SEC requires automated clients to identify themselves or it rate-limits you.
SEC_USER_AGENT=Your Name your@email.com


# --- SECRET: keep OUT of OneDrive -----------------------------------------
# Needed only by the ingest pipeline, which writes to the database.
# Dashboard -> Project Settings -> API Keys -> reveal `service_role`,
# or create a new secret key (sb_secret_...). It bypasses row level security,
# so treat it like a database password.

SUPABASE_SERVICE_KEY=
